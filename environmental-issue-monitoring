ran dalam pemanfaatan lahan pascakarhutla. \\n\\nFollow @antaratv untuk info terkini lainnya dan saksikan berita selengkapnya di YouTube AntaraTV Indonesia dan antaranews.com/video\\n\\n#karhutla #kebunsawit #DPR #antaratv\",\n          \"Upin Ipin Roasting Kebakaran Hutan dan Lahan Indonesia\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"
