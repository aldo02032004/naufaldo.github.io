        "\n",
        "\n",
        "def load_raw_data(source: str, sheet_name=None, skiprows: int = 1) -> pd.DataFrame:\n",
        "    url = resolve_xlsx_url(source)\n",
        "    file_obj = _download_bytes(url) if url.startswith(\"http\") else url\n",
        "    xls = pd.ExcelFile(file_obj)\n",
