        "        print(f\"[INFO] Menggunakan sheet: '{sheet_name}'\")\n",
        "\n",
        "    df = pd.read_excel(xls, sheet_name=sheet_name, skiprows=skiprows)\n",
        "    df.columns = [c.strip() for c in df.columns]\n",
        "\n",
        "    missing = [c for c in expected_cols if c not in df.columns]\n",
        "    if missing:\n",
