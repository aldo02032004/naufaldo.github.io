        "# =========================================================\n",
        "# CELL 7A — VISUAL GABUNGAN: PETA + BAR CHART (1 FIGURE, MENYAMPING)\n",
        "# Beda dari plot_dashboard(): layout 1x2 (bukan grid), dan bar isu\n",
        "# tertinggi di-breakdown per provinsi (stacked) biar kelihatan provinsi\n",
        "# mana penyumbang terbesar dari isu itu.\n",
        "# =========================================================\n",
        "import matplotlib.colors as mcolors\n",
        "from matplotlib.colors import PowerNorm\n",
        "\n",
        "TITLE_SIZE = 26\n",
        "\n",
        "\n",
        "def _format_period(start, end):\n",
        "    return f\"{start} - {end}\"\n",
        "\n",
        "\n",
        "def plot_combined(data: pd.DataFrame, start_date, end_date):\n",
        "    fig, (ax1, ax2) = plt.subplots(\n",
        "        1, 2, figsize=(38, 9),\n",
        "        gridspec_kw={\"width_ratios\": [1.3, 1]}\n",
        "    )\n",
        "\n",
        "    # --- SUBPLOT 1 (KIRI): PETA CHOROPLETH INDONESIA ---\n",
        "    map_gdf = _get_map_gdf(data)\n",
        "    if map_gdf.empty:\n",
        "        print(\"[WARNING] Peta tidak dapat dirender.\")\n",
        "    else:\n",
        "        prov_col = _detect_province_column(map_gdf)\n",
        "        if prov_col is None:\n",
        "            print(\"[ERROR] Kolom provinsi tidak ditemukan.\")\n",
        "        else:\n",
        "            map_gdf.plot(\n",
        "                column=\"jumlah_kasus\", cmap=CMAP_NAME, linewidth=0.5, edgecolor=\"black\",\n",
        "                ax=ax1, legend=False,\n",
        "                missing_kwds={\"color\": \"#ffffe0\", \"edgecolor\": \"black\", \"linewidth\": 0.5},\n",
        "            )\n",
        "\n",
        "            def _draw_badge(x, y, value):\n",
        "                ax1.text(\n",
        "                    x, y, f\"{int(value)}\", ha=\"center\", va=\"center\", zorder=10,\n",
        "                    fontsize=18, fontweight=\"bold\", color=\"black\",\n",
        "                    bbox=dict(boxstyle=\"circle,pad=0.25\", facecolor=\"white\", edgecolor=\"black\", linewidth=0.8),\n",
        "                )\n",
        "\n",
        "            for _, row in map_gdf.iterrows():\n",
        "                value = row[\"jumlah_kasus\"]\n",
        "                if value <= 0:\n",
        "                    continue\n",
        "\n",
        "                # pakai _normalize_geo_name (bukan _normalize_data_name) — row ini\n",
        "                # dari map_gdf/GeoJSON, sama seperti _get_map_gdf normalisasi provinsi_normalized-nya.\n",
        "                province = _normalize_geo_name(row[prov_col])\n",
        "\n",
        "                if province in MANUAL_BADGE_POSITION:\n",
        "                    x, y = MANUAL_BADGE_POSITION[province]\n",
        "                else:\n",
        "                    point = _main_point(row.geometry)\n",
        "                    x, y = point.x, point.y\n",
        "\n",
        "                _draw_badge(x, y, value)\n",
        "\n",
        "            ax1.set_title(\n",
        "                f\"Persebaran Isu Lingkungan di Indonesia\\n{_format_period(start_date, end_date)}\",\n",
        "                fontsize=TITLE_SIZE, fontweight=\"bold\", family=\"serif\", pad=20,\n",
        "            )\n",
        "            ax1.axis(\"off\")\n",
        "\n",
        "    # --- SUBPLOT 2 (KANAN): BAR CHART DISTRIBUSI ISU NASIONAL ---\n",
        "    # Isu dengan jumlah kasus tertinggi dipecah (stacked) per provinsi,\n",
        "    # supaya terlihat provinsi mana penyumbang terbesar dari isu tersebut.\n",
        "    TOP_N_PROVINSI_DETAIL = 6  # provinsi individual yang ditampilkan; sisanya digabung \"Lainnya\"\n",
        "\n",
        "    if \"Isu_Inti\" not in data.columns:\n",
        "        print(\"[ERROR] Kolom 'Isu_Inti' tidak ditemukan.\")\n",
        "    else:\n",
        "        counts = data[\"Isu_Inti\"].value_counts().sort_values(ascending=True)\n",
        "        top_issue = counts.index[-1]\n",
        "        max_value = counts.max()\n",
        "\n",
        "        cmap = plt.get_cmap(CMAP_NAME)\n",
        "        norm = PowerNorm(gamma=0.4, vmin=0, vmax=map_gdf[\"jumlah_kasus\"].max())\n",
        "\n",
        "        y_positions = list(range(len(counts)))\n",
        "        top_y = y_positions[-1]\n",
        "\n",
        "        # --- bar biasa (semua isu selain isu tertinggi) ---\n",
        "        for y_pos, isu in zip(y_positions, counts.index):\n",
        "            if isu == top_issue:\n",
        "                continue\n",
        "            value = counts[isu]\n",
        "            color = cmap(norm(value))\n",
        "            ax2.barh(y_pos, value, color=color, height=0.7)\n",
        "\n",
        "            is_dark = norm(value) > 0.55\n",
        "            text_color = \"white\" if is_dark else \"black\"\n",
        "            text_x = value - max_value * 0.01 if is_dark else value + max_value * 0.015\n",
        "            ha = \"right\" if is_dark else \"left\"\n",
        "            ax2.text(\n",
        "                text_x, y_pos, f\"{int(value)}\", va=\"center\", ha=ha,\n",
        "                fontsize=10, fontweight=\"bold\", color=text_color,\n",
        "            )\n",
        "\n",
        "        # --- bar isu tertinggi: dipecah per provinsi (stacked + gradasi) ---\n",
        "        UNDETECTED_LABEL = \"TIDAK DIKETAHUI\"  # sesuai output _normalize_data_name\n",
        "\n",
        "        subset_top = data.loc[data[\"Isu_Inti\"] == top_issue, \"Provinsi\"].dropna()\n",
        "        if subset_top.empty or \"Provinsi\" not in data.columns:\n",
        "            value = counts[top_issue]\n",
        "            ax2.barh(top_y, value, color=cmap(norm(value)), height=0.7)\n",
        "            ax2.text(value + max_value * 0.015, top_y, f\"{int(value)}\", va=\"center\",\n",
        "                      fontsize=10, fontweight=\"bold\", color=\"black\")\n",
        "        else:\n",
        "            # pakai _normalize_data_name konsisten dengan _get_aggs/_get_island_aggs\n",
        "            prov_counts_raw = subset_top.apply(_normalize_data_name).value_counts().sort_values(ascending=False)\n",
        "\n",
        "            prov_counts = prov_counts_raw[prov_counts_raw.index != UNDETECTED_LABEL]\n",
        "            undetected_count = prov_counts_raw.get(UNDETECTED_LABEL, 0)\n",
        "\n",
        "            if len(prov_counts) > TOP_N_PROVINSI_DETAIL:\n",
        "                prov_display = prov_counts.iloc[:TOP_N_PROVINSI_DETAIL].copy()\n",
        "                lainnya_total = prov_counts.iloc[TOP_N_PROVINSI_DETAIL:].sum() + undetected_count\n",
        "            else:\n",
        "                prov_display = prov_counts.copy()\n",
        "                lainnya_total = undetected_count\n",
        "\n",
        "            if lainnya_total > 0:\n",
        "                prov_display[\"Lainnya\"] = lainnya_total\n",
        "\n",
        "            total_top = prov_display.sum()\n",
        "            max_seg = prov_counts.iloc[0] if len(prov_counts) > 0 else lainnya_total\n",
        "            left = 0.0\n",
        "            for prov, val in prov_display.items():\n",
        "                if prov == \"Lainnya\":\n",
        "                    seg_color = \"#c9c9c9\"\n",
        "                    shade = 0.0\n",
        "                else:\n",
        "                    shade = 0.40 + 0.58 * (val / max_seg)\n",
        "                    seg_color = cmap(shade)\n",
        "\n",
        "                ax2.barh(top_y, val, left=left, color=seg_color, height=0.7,\n",
        "                          edgecolor=\"white\", linewidth=0.9)\n",
        "\n",
        "                frac = val / total_top\n",
        "                if frac > 0.03:\n",
        "                    is_dark = shade > 0.55\n",
        "                    txt_color = \"white\" if is_dark else \"#222222\"\n",
        "                    display_name = prov if prov == \"Lainnya\" else prov.title()\n",
        "                    label = f\"{display_name}\\n{int(val)}\" if frac > 0.05 else f\"{int(val)}\"\n",
        "                    ax2.text(left + val / 2, top_y, label, ha=\"center\", va=\"center\",\n",
        "                              fontsize=9 if frac > 0.05 else 7.5, fontweight=\"bold\", color=txt_color)\n",
        "                left += val\n",
        "\n",
